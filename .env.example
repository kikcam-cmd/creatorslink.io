# Copy to .env.local and fill in from Supabase dashboard → Project Settings → API.
# In Vercel, set these same three under Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by lib/auth-actions.ts for the signup confirm-email redirect.
# Local: http://localhost:3000   Prod: https://creatorslink.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Phase 4: reminders cron (set these in Vercel → Project → Settings → Env Vars) ──
# Service-role key (Supabase dashboard → Project Settings → API → service_role).
# SERVER-ONLY — bypasses Row-Level Security. NEVER prefix with NEXT_PUBLIC_ and
# never commit the real value. Used by the reminders cron to read across creators.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (resend.com → API Keys) for sending the reminder digest.
RESEND_API_KEY=

# Verified Resend sender. Format: "CreatorsLink <reminders@send.creatorslink.io>".
# The domain must be verified in Resend (DNS records) before mail will send.
REMINDER_FROM_EMAIL=

# Shared secret protecting /api/cron/reminders. Vercel auto-sends it as
# `Authorization: Bearer <value>` to scheduled cron invocations. Generate a long
# random string. Without it set, the cron route returns 401 (fails closed).
CRON_SECRET=
